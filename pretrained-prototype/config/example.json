{
  "model_a": {
    "provider": "anthropic",
    "model": "claude-sonnet-4-20250514",
    "temperature": 0.3,
    "max_tokens": 4096
  },
  "model_b": {
    "provider": "anthropic",
    "model": "claude-sonnet-4-20250514",
    "temperature": 0.7,
    "max_tokens": 8192
  },
  "neo4j": {
    "uri": "bolt://localhost:7687",
    "user": "neo4j",
    "password": "password",
    "database": "neo4j"
  },
  "context": {
    "model_a_context_window": 50000,
    "model_b_max_context": 100000,
    "max_memory_nodes": 50,
    "max_tools_to_consider": 100,
    "compaction_threshold": 40000
  },
  "pruning": {
    "enabled": true,
    "interval_seconds": 60,
    "max_nodes": 10000,
    "relevance_threshold": 0.3,
    "age_decay_factor": 0.95
  },
  "system_prompt_path": "./config/system_prompt.md",
  "mcp_config_path": "./config/mcp.json",
  "debug": false
}
